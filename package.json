{
  "name": "quanos",
  "version": "0.1.0",
  "private": true,
  "description": "Quanos coding-challenge service. Node.js + Clean Architecture, MongoDB-backed REST API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/main/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise --output-type dot src | dot -T svg > dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "prepare": "echo 'no prepare step yet'"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.10.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.7.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "globals": "^15.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "yaml": "^2.8.4"
  }
}
